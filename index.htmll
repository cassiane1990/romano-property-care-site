<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>ROMANO PROPERTY CARE</title>
<script src="https://cdn.jsdelivr.net/npm/pako@2.1.0/dist/pako.min.js"></script>
</head>
<body>
<div id="loader" style="font-family:Arial,sans-serif;padding:40px;text-align:center">Cargando ROMANO PROPERTY CARE…</div>
<script>
(async()=>{
  try{
    const base='./site-payload/';
    const parts=await Promise.all(['1.txt','2.txt','3.txt','4.txt'].map(async f=>{
      const r=await fetch(base+f+'?v=2',{cache:'no-store'});
      if(!r.ok) throw new Error('No se pudo cargar '+f+' ('+r.status+')');
      return (await r.text()).trim();
    }));
    const b64=parts.join('');
    const bin=Uint8Array.from(atob(b64),c=>c.charCodeAt(0));
    if(!window.pako) throw new Error('No se pudo cargar el descompresor');
    const html=pako.ungzip(bin,{to:'string'});
    document.open();
    document.write(html);
    document.close();
  }catch(e){
    console.error('ROMANO PROPERTY CARE loader:',e);
    document.body.innerHTML='<div style="font-family:Arial,sans-serif;padding:40px;text-align:center"><h2>ROMANO PROPERTY CARE</h2><p>No se pudo cargar el sitio. Recarga la página.</p></div>';
  }
})();
</script>
</body>
</html>
